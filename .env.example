# Local development (docker compose). Never use these values outside your machine.
MIGRATOR_DATABASE_URL=postgres://joybot_migrator:migrator@localhost:5433/joybot
APP_DATABASE_URL=postgres://joybot_app:app_local@localhost:5433/joybot
READER_DATABASE_URL=postgres://joybot_reader:reader_local@localhost:5433/joybot
APP_DB_PASSWORD=app_local
READER_DB_PASSWORD=reader_local
WORKER_DB_PASSWORD=worker_local

# API
PORT=3000
# 'dev' accepts the x-dev-principal header (local only); 'cognito' verifies Cognito JWTs.
AUTH_MODE=dev
CUSTOMERS_USER_POOL_ID=
CUSTOMERS_CLIENT_ID=
EMPLOYEES_USER_POOL_ID=
EMPLOYEES_CLIENT_ID=
WORKER_DATABASE_URL=postgres://joybot_worker:worker_local@localhost:5433/joybot

# Stripe (local): webhook signing secret from `stripe listen`, restricted read-only key for reconciliation.
STRIPE_WEBHOOK_SECRET=
STRIPE_RESTRICTED_KEY=
# Invoice card payments: a restricted key with Checkout Sessions write (empty = bank transfer only)
STRIPE_CHECKOUT_KEY=

# Encrypts secrets stored in the database (the Resend API key from Admin > Email). Optional locally:
# AUTH_MODE=dev falls back to a fixed development key. In AWS it is generated (Secrets Manager).
SETTINGS_ENCRYPTION_KEY=

# The API's public origin for OAuth redirects (Google Meet). Empty: the request's own origin
# (locally http://localhost:5173 through the web dev server's /api proxy).
API_PUBLIC_URL=

# Hosts other than AWS (docs/deploy-free.md). Leave empty locally and in AWS.
# Web app origins on another domain, comma-separated (e.g. https://appjoy.dev).
CORS_ORIGINS=
# log | live (SES, AWS WhatsApp) | resend (every email through Admin > Email, no WhatsApp).
MESSAGING_MODE=
# AUTH_MODE=supabase: the project URL and service-role key (server-side only); the JWT secret only for
# projects still on legacy shared-secret tokens.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# With DB_SSL=true: the database's CA when it is not RDS (Supabase), PEM text or a file path.
DB_SSL_CA=
DB_SSL_CA_FILE=

# Model (local, optional): Ollama's OpenAI-compatible endpoint. Empty = evidence-only answers.
MODEL_ENDPOINT=
MODEL_NAME=gemma
# true logs every model prompt and response in the API console (AUTH_MODE=dev only).
MODEL_DEBUG=false
# Gemma's thinking step: plan (picking tools only, default), all (slower answers) or off
MODEL_THINKING=plan

